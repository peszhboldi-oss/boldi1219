# Optional: copy to .env. No credentials are required in this file.
NODE_ENV=development
PORT=8082
APP_TIMEZONE=Europe/Budapest
# Optional custom SQLite file path. Empty means data/impavidus.sqlite.
SQLITE_PATH=
# Set true only behind a properly configured HTTPS reverse proxy.
COOKIE_SECURE=false
# Production only: e.g. https://your-own-domain.example. Host allowlist.
PUBLIC_ORIGIN=
# DATABASE_URL is deliberately absent: PostgreSQL is not connected in this release.
# Sessions use cryptographically random opaque tokens, not a shared SESSION_SECRET.

# Automatic SQLite backups include photos. 0 disables scheduling.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30
# Optional separate backup directory (default: backups/)
BACKUP_DIRECTORY=
