# Copy to /etc/impavidus-lab.env on the server; replace the domain.
NODE_ENV=production
PORT=8082
APP_TIMEZONE=Europe/Budapest
COOKIE_SECURE=true
PUBLIC_ORIGIN=https://app.your-domain.example
SQLITE_PATH=/var/lib/impavidus-lab/impavidus.sqlite
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30
BACKUP_DIRECTORY=/var/backups/impavidus-lab
