[Unit]
Description=IMPAVIDUS LAB
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=impavidus
Group=impavidus
WorkingDirectory=/opt/impavidus-lab
EnvironmentFile=/etc/impavidus-lab.env
ExecStart=/usr/bin/node /opt/impavidus-lab/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/impavidus-lab /var/backups/impavidus-lab
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
